# Secreto compartido para firmar y validar los JWT. Cámbialo antes de desplegar.
JWT_SECRET=cambia-esto-en-produccion
JWT_ISSUER=reto-tecnico
JWT_EXPIRES_IN=1h

# Credenciales aceptadas por POST /auth/login, como lista de usuario:clave separada por comas.
AUTH_USERS=admin:admin123,analista:analista123

# Puertos que docker compose publica en el host.
GO_API_PORT=8080
NODE_API_PORT=3000
FRONTEND_PORT=8081

# Límites.
MAX_MATRIX_DIM=200
REQUEST_TIMEOUT=5s
